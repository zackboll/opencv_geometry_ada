with "../../opencv_geometry.gpr";

--  Compiles the developer-guide examples; never part of the library build.
--  Every Ada fence in docs/guides is exactly one of these programs.
project Examples is
   for Source_Dirs use (".");
   for Object_Dir use "../../obj/docs-examples";
   for Exec_Dir use "../../obj/docs-examples";
   for Create_Missing_Dirs use "True";
   for Main use
     ("contours_and_moments.adb",
      "fitting_and_intersections.adb",
      "affine_and_perspective.adb",
      "delaunay_and_voronoi.adb",
      "compatibility_and_safety.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-Werror");
   end Compiler;
end Examples;
