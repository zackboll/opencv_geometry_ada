with "config/opencv_geometry_config.gpr";
with "config/opencv_geometry_install.gpr";

project OpenCV_Geometry_Shim is

   for Library_Name use "opencv_geometry_shim";

   for Languages use ("C++");
   for Source_Dirs use ("cpp/");
   for Object_Dir use
     "obj/shim/" & OpenCV_Geometry_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   case OpenCV_Geometry_Install.Shim_Build is
      when "Static_PIC" =>
         for Library_Kind use "static-pic";
      when "Relocatable" =>
         for Library_Kind use "relocatable";
      when "External_Relocatable" =>
         for Externally_Built use "True";
         for Languages use ();
         for Source_Dirs use ();
         for Library_Kind use "relocatable";
   end case;

   Common_Cxx_Switches :=
     ("-std=c++17",
      "-Wall",
      "-Wextra",
      "-Wpedantic",
      "-Werror",
      OpenCV_Geometry_Install.Include_Switch);

   package Compiler is
      case OpenCV_Geometry_Install.Cxx_Toolchain is
         when "GNU" =>
            for Default_Switches ("C++") use Common_Cxx_Switches;
            for Driver ("C++") use OpenCV_Geometry_Install.Cxx_Driver;
         when "Apple_Clang" =>
            --  OpenCV headers use C11 _Atomic through CV_XADD. Retain
            --  -Werror while allowing that system-header extension.
            for Default_Switches ("C++") use
              Common_Cxx_Switches & ("-Wno-error=c11-extensions");
            for Driver ("C++") use OpenCV_Geometry_Install.Cxx_Driver;
            for Leading_Required_Switches ("C++") use
              ("-c",
               "-x",
               "c++",
               "-isysroot",
               OpenCV_Geometry_Install.Cxx_Sysroot);
            for Include_Switches ("C++") use ("-I");
            for Dependency_Switches ("C++") use ("-MMD", "-MF", "");
      end case;
   end Compiler;

   case OpenCV_Geometry_Install.Shim_Build is
      when "Relocatable" =>
         --  The Geometry dylib owns its OpenCV/libc++ boundary.
         for Library_Options use
           ("-isysroot",
            OpenCV_Geometry_Install.Cxx_Sysroot,
            OpenCV_Geometry_Install.Library_Search_Switch,
            OpenCV_Geometry_Install.OpenCV_Geometry_Link_Option,
            OpenCV_Geometry_Install.OpenCV_Core_Link_Option,
            OpenCV_Geometry_Install.Cxx_Runtime_Switch);
      when "Static_PIC" | "External_Relocatable" =>
         null;
   end case;

   package Linker is
      case OpenCV_Geometry_Install.Shim_Build is
         when "Static_PIC" =>
            for Linker_Options use
              (OpenCV_Geometry_Install.Library_Search_Switch,
               OpenCV_Geometry_Install.OpenCV_Geometry_Link_Option,
               OpenCV_Geometry_Install.OpenCV_Core_Link_Option,
               OpenCV_Geometry_Install.Cxx_Runtime_Switch);
         when "Relocatable" =>
            for Driver use OpenCV_Geometry_Install.Cxx_Driver;
         when "External_Relocatable" =>
            null;
      end case;
   end Linker;

end OpenCV_Geometry_Shim;
