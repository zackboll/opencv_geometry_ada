--  GNAT Pro 25.2 harness; same strict development checks as the GNAT 12
--  harness, but a separately identified build directory and track.
with "aunit.gpr";
with "opencv_geometry.gpr";

abstract project Tests_Config is
   Build_Profile := "adacore25-development";
   Ada_Compiler_Switches :=
     ("-Og", "-ffunction-sections", "-fdata-sections", "-g", "-gnatwa",
      "-gnatw.X", "-gnatVa", "-gnaty3", "-gnatya", "-gnatyA", "-gnatyB",
      "-gnatyb", "-gnatyc", "-gnaty-d", "-gnatye", "-gnatyf", "-gnatyh",
      "-gnatyi", "-gnatyI", "-gnatyk", "-gnatyl", "-gnatym", "-gnatyn",
      "-gnatyO", "-gnatyp", "-gnatyr", "-gnatyS", "-gnatyt", "-gnatyu",
      "-gnatyx", "-gnatW8");
end Tests_Config;