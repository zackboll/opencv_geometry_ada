with "opencv_geometry";
with "opencv_core";

project Geometry_Core_Consumer is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("geometry_core_consumer.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-Werror");
   end Compiler;
end Geometry_Core_Consumer;