--  Independent Ada consumer of the installed opencv_core and
--  opencv_geometry projects. Resolve both through GPR_PROJECT_PATH only.
with "opencv_core";
with "opencv_geometry";

project Ada_Consumer is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Source_Files use
     ("installed_geometry_consumer.adb",
      "geometry_consumer_checks.ads",
      "geometry_consumer_checks.adb");
   for Main use ("installed_geometry_consumer.adb");
   for Object_Dir use "obj-ada";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnatwe", "-Werror");
   end Compiler;
end Ada_Consumer;
