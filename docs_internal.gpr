with "config/opencv_geometry_config.gpr";
with "opencv_core.gpr";

--  Internal Geometry interop units are parsed only for name resolution.
project Docs_Internal is
   for Languages use ("Ada");
   for Source_Dirs use ("src/internal");
   for Object_Dir use "obj/docs-internal";

   package Compiler is
      for Default_Switches ("Ada") use
        Opencv_Geometry_Config.Ada_Compiler_Switches & ("-Werror");
   end Compiler;
end Docs_Internal;
