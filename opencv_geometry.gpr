with "opencv_core.gpr";
with "config/opencv_geometry_config.gpr";
with "config/opencv_geometry_install.gpr";
with "opencv_geometry_shim.gpr";

project Opencv_Geometry is

   for Library_Name use "opencv_geometry_ada";

   for Languages use ("Ada");
   for Source_Dirs use ("src/", "src/internal/", "config/");
   for Object_Dir use "obj/" & Opencv_Geometry_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external
       ("OPENCV_GEOMETRY_LIBRARY_TYPE",
        external ("LIBRARY_TYPE", "static-pic"));
   for Library_Kind use Library_Type;

   --  When the C++ shim is built externally as a shared library, Ada
   --  consumers must explicitly link it. macOS uses a dylib; Windows
   --  uses a DLL/import library.
   case Library_Type is
      when "relocatable" =>
         case Opencv_Geometry_Install.Shim_Build is
            when "External_Relocatable" =>
               case Opencv_Geometry_Install.Cxx_Toolchain is
                  when "Apple_Clang" =>
                     for Library_Options use
                       ("-L" & Project'Project_Dir & "lib",
                        "-lopencv_geometry_shim",
                        "-Wl,-rpath," & Project'Project_Dir & "lib");
                  when "GNU" =>
                     for Library_Options use
                       ("-L" & Project'Project_Dir & "lib",
                        "-lopencv_geometry_shim");
               end case;
            when "Static_PIC" | "Relocatable" =>
               null;
         end case;

      when "static" | "static-pic" =>
         null;
   end case;

   package Compiler is
      for Default_Switches ("Ada") use
        Opencv_Geometry_Config.Ada_Compiler_Switches & ("-Werror");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      --  External_Relocatable is used on macOS and Windows. The C++ shim
      --  is independently built, so Ada consumers must link it explicitly.
      case Opencv_Geometry_Install.Shim_Build is
         when "External_Relocatable" =>
            case Opencv_Geometry_Install.Cxx_Toolchain is
               when "Apple_Clang" =>
                  --  The macOS shim uses @rpath. Consumers need this
                  --  crate's lib directory at runtime; -L is link-time
                  --  only. Do not apply Mach-O rpath on Windows.
                  for Linker_Options use
                    ("-L" & Project'Project_Dir & "lib",
                     "-lopencv_geometry_shim",
                     "-Wl,-rpath," & Project'Project_Dir & "lib");
               when "GNU" =>
                  for Linker_Options use
                    ("-L" & Project'Project_Dir & "lib",
                     "-lopencv_geometry_shim");
            end case;

         when "Static_PIC" | "Relocatable" =>
            null;
      end case;
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Opencv_Geometry;
